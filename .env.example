# Heslo pro admin sekci (/admin/)
ADMIN_PASSWORD=zmente-toto-heslo

# Volitelně: bcrypt hash místo plaintext ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=$2b$12$...

# Tajný klíč pro session (náhodný řetězec, min. 32 znaků)
SESSION_SECRET=nahodny-retezec-min-32-znaku-pro-produkci

# Port serveru
PORT=8080

# production = secure cookies + přísnější kontrola SESSION_SECRET
# NODE_ENV=production

# Vynutit HTTPS-only cookie i mimo production (za reverse proxy)
# COOKIE_SECURE=1

# Trust proxy (1 = zapnuto, 0 = vypnuto). Za Nginx/Caddy nechte zapnuto.
# TRUST_PROXY=1

# Odesílání PDF dokladů e-mailem (SMTP)
# SMTP_HOST=smtp.seznam.cz
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=vas@seznam.cz
# SMTP_PASS=heslo-nebo-app-password
# SMTP_FROM="IT Servis Třebíč <vas@seznam.cz>"
